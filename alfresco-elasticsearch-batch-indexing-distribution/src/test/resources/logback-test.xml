<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Reliability IT diagnostics (our tests + container log-consumer prefix). -->
    <logger name="org.alfresco.elasticsearch.batchindexing.reliability" level="INFO"/>

    <!-- Testcontainers is chatty at INFO; WARN keeps the noise down. -->
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>
    <logger name="tc.testcontainers" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
