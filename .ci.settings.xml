<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Cloudsmith credentials for publishing to the community repository
  (exported by the cloudsmith-auth action).
  Installed by the setup-java-build action; used only by the release job.
  The build job overrides it with .github/empty-settings.xml so that the
  ordinary build is proven to need no credentials.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <servers>
    <server>
      <id>alfresco-releases</id>
      <username>${env.CLOUDSMITH_USERNAME}</username>
      <password>${env.CLOUDSMITH_API_KEY}</password>
    </server>
  </servers>
</settings>
